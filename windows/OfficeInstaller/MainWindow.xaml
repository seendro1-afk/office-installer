<Window x:Class="OfficeInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:OfficeInstaller.Views"
        Title="Office Installer" Width="760" Height="840"
        MinWidth="640" MinHeight="600" WindowStartupLocation="CenterScreen"
        Background="#F5F5F7" FontFamily="Segoe UI" FontSize="13">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TabControl x:Name="MainTabs" Margin="12,12,12,0" Padding="0" Background="White" BorderThickness="0">
      <TabItem Header="Установка Office">
        <views:InstallationView x:Name="InstallView" />
      </TabItem>
      <TabItem Header="Восстановление Office">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="30">
            <TextBlock Text="Восстановление Office" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Проверка установленных приложений и возможности их повторной установки." Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
            <Separator />
            <WrapPanel>
              <Button x:Name="ScanButton" Content="Проверить Office" Click="Scan_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
              <Button x:Name="ExportButton" Content="Сохранить отчёт" Click="Export_Click" IsEnabled="False" Margin="0,0,8,8" />
            </WrapPanel>
            <ProgressBar x:Name="ScanProgress" Height="5" IsIndeterminate="True" Visibility="Collapsed" Margin="0,6,0,10" />
            <TextBlock x:Name="StatusText" Text="Проверка ещё не выполнялась. Права администратора не требуются." Style="{StaticResource Caption}" Margin="0,4,0,16" />
            <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="0,0,0,16" />
            <ItemsControl x:Name="WarningsList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#FFF3DC" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                  <TextBlock Text="{Binding}" Foreground="#754A00" />
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <ItemsControl x:Name="ProductsList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#F3F3F5" CornerRadius="12" Padding="14" Margin="0,0,0,14">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                      <TextBlock Grid.Column="1" Text="Запись найдена" Foreground="#24843E" FontSize="12" Margin="14,2,0,0" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"><Run Text="Версия: " /><Run Text="{Binding Build, Mode=OneWay}" /></TextBlock>
                    <TextBlock Margin="0,6,0,0"><Run Text="Тип установки: " /><Run Text="{Binding InstallTypeLabel, Mode=OneWay}" /></TextBlock>
                    <TextBlock Text="{Binding RepairDescription}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,10,0,0" />
                    <WrapPanel Margin="0,12,0,0">
                      <Button Content="Восстановить" Click="Repair_Click" Tag="{Binding}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" />
                      <Button Content="Переустановить текущую версию" Click="Reinstall_Click" Tag="{Binding}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <Expander Header="Подробности установки" Margin="0,4,0,0">
                      <StackPanel Margin="0,8,0,0">
                        <TextBlock><Run Text="Выпуск: " /><Run Text="{Binding Release, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,5,0,0"><Run Text="Разрядность: " /><Run Text="{Binding Architecture, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,5,0,0"><Run Text="Язык: " /><Run Text="{Binding Language, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,5,0,0"><Run Text="Идентификатор: " /><Run Text="{Binding ProductId, Mode=OneWay}" /></TextBlock>
                        <TextBlock Margin="0,5,0,0"><Run Text="Область установки: " /><Run Text="{Binding Scope, Mode=OneWay}" /></TextBlock>
                        <TextBlock Text="{Binding Source}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="FilesHeading" Text="Приложения Office" Style="{StaticResource SectionTitle}" Visibility="Collapsed" Margin="0,16,0,8" />
            <TextBlock x:Name="FilesNote" Text="Файлы найдены в проверенных папках Office. Новый Outlook и приложения Microsoft Store отдельно не проверяются." Style="{StaticResource Caption}" Visibility="Collapsed" />
            <ItemsControl x:Name="FilesList">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Border Background="#F3F3F5" Padding="14" CornerRadius="12" Margin="0,0,0,12">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                      <TextBlock FontSize="15" FontWeight="SemiBold"><Run Text="Microsoft " /><Run Text="{Binding Name, Mode=OneWay}" /></TextBlock>
                      <TextBlock Grid.Column="1" Text="Файл найден" Foreground="#24843E" FontSize="12" Margin="14,2,0,0" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"><Run Text="Версия: " /><Run Text="{Binding Version, Mode=OneWay}" /></TextBlock>
                    <Expander Header="Расположение файла" Margin="0,8,0,0">
                      <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0" />
                    </Expander>
                  </StackPanel>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="Диагностика не изменяет приложения, документы, настройки или лицензии Office. Наличие записи или файла не подтверждает исправность приложения." Style="{StaticResource Caption}" Margin="0,16,0,0" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border Grid.Row="1" BorderBrush="#DDDDDF" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel>
        <ProgressBar x:Name="OperationProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8" />
        <ScrollViewer MaxHeight="92" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="OperationStatus" Text="Операции запускаются только по вашему действию и подтверждению." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
